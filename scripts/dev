#!/usr/bin/env bash
# scripts/dev — Yeah development wrapper.
#
# Subcommands:
#   smoke                 — print "yeah-dev ok" and exit 0
#   byte-compile-all      — byte-compile every file under lib/ and the package entry
#   ert FILE...           — run ERT test files (tests/unit/*.el)
#   check FILE...         — run the checks; every check has a limit of time
#   bench [--run]         — validate the benchmark task set, or run the benchmark
#   pixel                 — photograph the real interface and compare two pictures
#   diagrams              — render every diagram of site/diagrams in both themes
#   map                   — the standing specification: claims, states, uncovered
#   run                   — execute the checks, bind the evidence, write the trail
#   gate                  — the gate of the project (scripts/gate); the exit code is the verdict
#   help                  — this text
#
# Exit codes (the method's scale, A13/A14):
#   0 — pass       (Green)
#   1 — fail       (Red)
#   2 — blocked    (input error: bad arguments, unknown subcommand)
#   3 — unknown    (the method could not tell: a tool is missing, a check
#                    did not run, a control did not bite, a check passed its
#                    limit of time and was stopped)
#
# The method binary is `mathc`: set MATHC to its path, or put it on PATH.
# It comes from the math-coding repository (`nix build` there writes
# ./result/bin/mathc). The method's own files — spec.json and waves/ — are
# part of this project, not of the tool.

set -u

cmd="${1:-help}"
[ $# -gt 0 ] && shift

# The place of the method is one thing, and it lives in one place: the
# copy of the search that lives in two scripts is a copy that drifts
# apart, and the copy that drifts is the one that runs the gate of the
# project with no method at all.
script_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=scripts/lib/method.sh
. "$script_dir/lib/method.sh"
# shellcheck source=scripts/lib/copies.sh
. "$script_dir/lib/copies.sh"
# shellcheck source=scripts/lib/tools.sh
. "$script_dir/lib/tools.sh"

# The search for Emacs is one thing and it lives in one place: the steps are
# the environment, PATH, the profile of the user and the store of nix.
find_emacs() {
  find_tool EMACS emacs
}

# The search for PlantUML has the same shape and one step more: the tool is
# the instrument of the author, it is not part of the runtime of the site,
# and the store of nix is the place where it lives when the profile of the
# user is swept.
find_plantuml() {
  find_tool PLANTUML plantuml "${NIX_STORE_DIR:-/nix/store}/*plantuml*/bin/plantuml"
}

# The script that runs a check under a limit of time.  It lives next to
# this script, so a clone of the repository runs the check the same way
# whatever the working directory is.
find_timeout() {
  if [ -x "$script_dir/dev-timeout" ]; then
    printf '%s' "$script_dir/dev-timeout"
    return 0
  fi
  return 1
}

need_mathc() {
  mathc_bin="$(find_mathc)" || {
    echo "scripts/dev $cmd: mathc is not on PATH and MATHC is not set." >&2
    echo "  Get it from the math-coding repository: nix build  (it writes result/bin/mathc)." >&2
    exit 3
  }
}

# Emacs loads a byte-compiled file when it exists, even when the source is
# newer ("Source file ... newer than byte-compiled file; using older file").
# A stale .elc next to a modified source therefore makes every check test
# yesterday's code instead of today's. The bytecode is a build artifact, not
# a part of the tree: it is removed before anything is loaded.
clean_bytecode() {
  rm -f lib/*.elc bench/*.elc
}

now_ms() {
  printf '%s' "$(( $(date +%s%N) / 1000000 ))"
}

case "$cmd" in
  help|--help|-h)
    cat <<'EOF'
scripts/dev — Yeah development wrapper

Subcommands:
  smoke                 — print "yeah-dev ok" and exit 0
  byte-compile-all      — byte-compile lib/*.el (including lib/yeah.el), no warnings
  ert FILE...           — run ERT test files (tests/unit/*.el)
  check FILE...         — run the checks; every check has a limit of time
  bench [--run]         — validate the benchmark task set, or run the benchmark
  pixel                 — photograph the real interface and compare two pictures
  diagrams              — render every diagram of site/diagrams in both themes
  map                   — the standing specification: claims, states, uncovered
  run                   — execute the checks, bind the evidence, write the trail
  gate                  — the gate of the project (scripts/gate); the exit code is the verdict
  help                  — this text

Exit codes:
  0 — pass       (Green)
  1 — fail       (Red)
  2 — blocked    (input error)
  3 — unknown    (the method could not tell)

Environment:
  MATHC  — path to the math-coding binary (default: `mathc` on PATH)
  EMACS  — path to the Emacs binary (default: `emacs` on PATH)
  PLANTUML
         — path to the PlantUML binary (default: `plantuml` on PATH, then
           ~/.nix-profile/bin, then the store of nix).  PlantUML draws the
           diagrams of the site; it is the instrument of the author and not
           a part of the runtime.
  NIX_STORE_DIR
         — the store of nix where the tools are looked for last (default:
           /nix/store)
  YEAH_CHECK_TIMEOUT
         — the limit of one check, in seconds (default: 120).  A check that
           passed the limit is stopped, and the run answers with the third
           answer (3, unknown): nothing was refuted, the method could not
           tell.
  YEAH_GATE_TIMEOUT
         — the limit of one attempt of the run of the gate, in seconds
           (default: 1800).  A run that passed the limit is stopped, and
           the gate answers with the third answer (3, unknown).
  YEAH_GATE_ATTEMPTS
         — the number of attempts of the gate (default: 3).  A run that
           was killed is started again; a run that answered is not.
EOF
    ;;

  smoke)
    echo "yeah-dev ok ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
    exit 0
    ;;

  byte-compile-all)
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev byte-compile-all: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    if [ ! -d lib ]; then
      echo "scripts/dev byte-compile-all: lib/ does not exist" >&2
      exit 3
    fi
    out="$("$emacs_bin" -Q --batch -L lib -f batch-byte-compile lib/*.el 2>&1)"
    rc=$?
    clean_bytecode
    printf '%s\n' "$out"
    if [ $rc -ne 0 ]; then
      echo "scripts/dev byte-compile-all: the compilation failed" >&2
      exit 1
    fi
    if printf '%s\n' "$out" | grep -q "Warning:"; then
      echo "scripts/dev byte-compile-all: the compilation produced warnings" >&2
      exit 1
    fi
    ;;

  ert)
    if [ $# -lt 1 ]; then
      echo "scripts/dev ert: needs at least one test file" >&2
      exit 2
    fi
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev ert: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    clean_bytecode
    load_args=()
    for f in "$@"; do
      load_args+=(-l "$f")
    done
    "$emacs_bin" -Q --batch -L lib -L . "${load_args[@]}" -f ert-run-tests-batch-and-exit
    ;;

  check)
    if [ $# -lt 1 ]; then
      echo "scripts/dev check: needs at least one check file" >&2
      exit 2
    fi
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev check: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    timeout_bin="$(find_timeout)" || {
      echo "scripts/dev check: scripts/dev-timeout is missing" >&2
      exit 3
    }
    # A check that hangs must not eat the gate: the gate waits for the
    # check, and a check that never ends never lets the gate finish.
    # Every check runs under a limit, and a check that passed the limit
    # is stopped and reported with the third answer -- the method could
    # not tell.  It is not a refutation: nothing was refuted.
    limit="${YEAH_CHECK_TIMEOUT:-120}"
    case "$limit" in
      ''|*[!0-9]*)
        echo "scripts/dev check: YEAH_CHECK_TIMEOUT must be a whole number of seconds" >&2
        exit 2
        ;;
    esac
    clean_bytecode
    blocked=0
    failed=0
    unknown=0
    started="$(now_ms)"
    # Every check owns a life socket.  The servers that the check starts
    # watch that socket and end when the check ends -- even when the check
    # was killed and never got the chance to stop them.  A server left
    # behind by a finished check holds its socket and waits for a client
    # that never comes.
    life_dir="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/yeah}"
    if [ -z "$life_dir" ]; then
      life_dir="${TMPDIR:-/tmp}/yeah-$(id -u)"
    fi
    mkdir -p "$life_dir" 2>/dev/null && chmod 700 "$life_dir" 2>/dev/null
    n=0
    for f in "$@"; do
      before="$(now_ms)"
      n=$((n + 1))
      case "$f" in
        *.el)
          life_sock="$life_dir/yeah-life-check-$n-$$.sock"
          YEAH_LIFE_SOCKET="$life_sock" "$timeout_bin" "$limit" \
            "$emacs_bin" -Q --batch -L lib -L . \
            --eval "(progn (require 'yeah-life) (yeah-life-adopt-from-environment))" \
            -l "$f"
          rc=$?
          rm -f "$life_sock"
          ;;
        *.sh)
          "$timeout_bin" "$limit" bash "$f"
          rc=$?
          ;;
        *)
          echo "scripts/dev check: unknown kind of check: $f" >&2
          exit 2
          ;;
      esac
      case "$rc" in
        0) ;;
        1) failed=1 ;;
        2) blocked=1 ;;
        3)
          unknown=1
          echo "scripts/dev check: the check passed the limit of ${limit}s and was stopped: $f" >&2
          ;;
        *) failed=1 ;;
      esac
      printf 'check: %6d ms  %s\n' "$(( $(now_ms) - before ))" "$f"
    done
    printf 'check: %6d ms  total for %s file(s)\n' "$(( $(now_ms) - started ))" "$#"
    # The order of the answers is the order of their strength: a blocked
    # run is not a run, a refutation is a statement, and "unknown" is the
    # absence of one.
    if [ "$blocked" -eq 1 ]; then
      exit 2
    fi
    if [ "$failed" -eq 1 ]; then
      exit 1
    fi
    if [ "$unknown" -eq 1 ]; then
      exit 3
    fi
    exit 0
    ;;

  bench)
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev bench: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    if [ ! -f bench/run-bench.el ]; then
      echo "scripts/dev bench: bench/run-bench.el does not exist" >&2
      exit 2
    fi
    mode="--self-check"
    for arg in "$@"; do
      case "$arg" in
        --run) mode="--run" ;;
        *)
          echo "scripts/dev bench: unknown option: $arg" >&2
          exit 2
          ;;
      esac
    done
    # The task checks call emacs themselves: EMACS tells them which one.
    # gptel is not part of this repository: YEAH_BENCH_GPTEL_PATH names the
    # directory it is installed in, so the Yeah harness can reach a provider.
    clean_bytecode
    gptel_args=()
    if [ -n "${YEAH_BENCH_GPTEL_PATH:-}" ]; then
      gptel_args=(-L "$YEAH_BENCH_GPTEL_PATH")
    fi
    EMACS="$emacs_bin" "$emacs_bin" -Q --batch "${gptel_args[@]}" -L lib -l bench/run-bench.el -- "$mode"
    exit $?
    ;;

  pixel)
    if [ ! -f tests/pixel/check-interface-is-seen.sh ]; then
      echo "scripts/dev pixel: tests/pixel/check-interface-is-seen.sh does not exist" >&2
      exit 2
    fi
    clean_bytecode
    bash tests/pixel/check-interface-is-seen.sh
    exit $?
    ;;

  diagrams)
    # The pipeline of the diagrams.  PlantUML is the instrument of the
    # author: the site publishes the pictures that are ready, and the site
    # itself has no build step.
    if [ $# -gt 0 ]; then
      echo "scripts/dev diagrams: takes no arguments" >&2
      exit 2
    fi
    if [ ! -d site/diagrams ]; then
      echo "scripts/dev diagrams: site/diagrams does not exist" >&2
      exit 2
    fi
    plantuml_bin="$(find_plantuml)" || {
      echo "scripts/dev diagrams: plantuml is not on PATH, PLANTUML is not set, and it is not in the store of nix" >&2
      exit 3
    }
    out_dir="site/assets/diagrams"
    mkdir -p "$out_dir" || {
      echo "scripts/dev diagrams: cannot make $out_dir" >&2
      exit 3
    }
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/yeah-diagrams.XXXXXX")" || {
      echo "scripts/dev diagrams: cannot make a temporary directory" >&2
      exit 3
    }
    # The pictures are written in the temporary directory first and moved to
    # their place one by one: a render that fails leaves no half-written
    # picture behind.
    trap 'rm -rf "$tmp"' EXIT
    diagrams=0
    pictures=0
    for src in site/diagrams/*.puml; do
      [ -f "$src" ] || continue
      name="$(basename "$src" .puml)"
      case "$name" in
        palette-*) continue ;;
      esac
      if ! grep -q '^[[:space:]]*@startuml' "$src"; then
        echo "scripts/dev diagrams: $src has no @startuml line" >&2
        exit 2
      fi
      for theme in light dark; do
        palette="site/diagrams/palette-$theme.puml"
        if [ ! -f "$palette" ]; then
          echo "scripts/dev diagrams: $palette does not exist" >&2
          exit 2
        fi
        # The skin of a theme goes inside the diagram: a skinparam outside of
        # @startuml is an error of PlantUML.  The file that is rendered is
        # named after the diagram and the theme, and PlantUML writes the
        # picture after the name of that file.
        wrapper="$tmp/$name-$theme.puml"
        sed "/^[[:space:]]*@startuml/r $palette" "$src" >"$wrapper"
        mkdir -p "$tmp/out"
        if ! "$plantuml_bin" -tsvg -o "$tmp/out" "$wrapper" >"$tmp/log" 2>&1; then
          echo "scripts/dev diagrams: plantuml failed on $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        picture="$tmp/out/$name-$theme.svg"
        if [ ! -s "$picture" ]; then
          echo "scripts/dev diagrams: plantuml wrote no picture for $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        if grep -q 'Syntax Error' "$picture"; then
          echo "scripts/dev diagrams: the picture of $name ($theme) is an error of PlantUML" >&2
          exit 1
        fi
        mv "$picture" "$out_dir/$name-$theme.svg"
        pictures=$((pictures + 1))
      done
      diagrams=$((diagrams + 1))
    done
    echo "diagrams: rendered $pictures picture(s) of $diagrams diagram(s) into $out_dir"
    ;;

  map)
    need_mathc
    "$mathc_bin" --root . map
    ;;

  run)
    need_mathc
    "$mathc_bin" --root . run
    rc=$?
    # The copies of the runs that are gone are removed after the run: a
    # run that was killed leaves its copy on disk, and the copy is about a
    # gigabyte of the machine that nobody asked to keep.  The copy of a run
    # that is alive is left alone.
    sweep_method_copies
    exit $rc
    ;;
  gate)
    # The gate of the project is one runner: scripts/gate.  This wrapper
    # does not keep a second copy of it.  Two copies of the gate are two
    # verdicts, and the copy that drifts is the one that runs the
    # project -- and the old copy was the one that waited for the run and
    # left it behind when the run was killed.
    if [ ! -x "$script_dir/gate" ]; then
      echo "scripts/dev gate: scripts/gate is missing" >&2
      exit 3
    fi
    exec "$script_dir/gate" "$@"
    ;;

  *)
    echo "scripts/dev: unknown subcommand: $cmd" >&2
    echo "Run \`scripts/dev help\` for the list of subcommands." >&2
    exit 2
    ;;
esac
