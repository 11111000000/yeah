#!/usr/bin/env bash
# scripts/dev — Yeah development wrapper.
#
# Subcommands:
#   smoke                 — print "yeah-dev ok" and exit 0
#   byte-compile-all      — byte-compile every file under lib/ and the package entry
#   ert FILE...           — run ERT test files (tests/unit/*.el)
#   check FILE...         — run the checks; every check has a limit of time
#   bench [--run]         — validate the benchmark task set, or run the benchmark
#   pixel                 — photograph the real interface and compare two pictures
#   diagrams              — render every diagram of site/diagrams in both themes
#   state-diagram         — write site/diagrams/state-machine.puml out of the code
#   map                   — the standing specification: claims, states, uncovered
#   run                   — execute the checks, bind the evidence, write the trail
#   gate                  — the gate of the project (scripts/gate); the exit code is the verdict
#   help                  — this text
#
# Exit codes (the method's scale, A13/A14):
#   0 — pass       (Green)
#   1 — fail       (Red)
#   2 — blocked    (input error: bad arguments, unknown subcommand)
#   3 — unknown    (the method could not tell: a tool is missing, a check
#                    did not run, a control did not bite, a check passed its
#                    limit of time and was stopped)
#
# The method binary is `mathc`: set MATHC to its path, or put it on PATH.
# It comes from the math-coding repository (`nix build` there writes
# ./result/bin/mathc). The method's own files — spec.json and waves/ — are
# part of this project, not of the tool.

set -u

cmd="${1:-help}"
[ $# -gt 0 ] && shift

# The place of the method is one thing, and it lives in one place: the
# copy of the search that lives in two scripts is a copy that drifts
# apart, and the copy that drifts is the one that runs the gate of the
# project with no method at all.
script_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=scripts/lib/method.sh
. "$script_dir/lib/method.sh"
# shellcheck source=scripts/lib/copies.sh
. "$script_dir/lib/copies.sh"
# shellcheck source=scripts/lib/tools.sh
. "$script_dir/lib/tools.sh"

# The search for Emacs is one thing and it lives in one place: the steps are
# the environment, PATH, the profile of the user and the store of nix.
find_emacs() {
  find_tool EMACS emacs
}

# The search for PlantUML has the same shape and one step more: the tool is
# the instrument of the author, it is not part of the runtime of the site,
# and the store of nix is the place where it lives when the profile of the
# user is swept.
find_plantuml() {
  find_tool PLANTUML plantuml "${NIX_STORE_DIR:-/nix/store}/*plantuml*/bin/plantuml"
}

# The search for D2 has the same shape as the search for PlantUML: the tool is
# the instrument of the author, it is not part of the runtime of the site, and
# the store of nix is the place where it lives when the profile of the user is
# swept.  D2 draws the pictures of the architecture bands; PlantUML draws the
# pictures of the classic notation.
find_d2() {
  find_tool D2 d2 "${NIX_STORE_DIR:-/nix/store}/*d2-*/bin/d2"
}

# The script that runs a check under a limit of time.  It lives next to
# this script, so a clone of the repository runs the check the same way
# whatever the working directory is.
find_timeout() {
  if [ -x "$script_dir/dev-timeout" ]; then
    printf '%s' "$script_dir/dev-timeout"
    return 0
  fi
  return 1
}

need_mathc() {
  mathc_bin="$(find_mathc)" || {
    echo "scripts/dev $cmd: mathc is not on PATH and MATHC is not set." >&2
    echo "  Get it from the math-coding repository: nix build  (it writes result/bin/mathc)." >&2
    exit 3
  }
}

# Emacs loads a byte-compiled file when it exists, even when the source is
# newer ("Source file ... newer than byte-compiled file; using older file").
# A stale .elc next to a modified source therefore makes every check test
# yesterday's code instead of today's. The bytecode is a build artifact, not
# a part of the tree: it is removed before anything is loaded.
clean_bytecode() {
  rm -f lib/*.elc bench/*.elc
}

now_ms() {
  printf '%s' "$(( $(date +%s%N) / 1000000 ))"
}

# The diagram of the state machine is written out of the code: a live Emacs
# reads the list of the states and the table of the transitions, and the file
# of the diagram is the result of that read.  The function is one, and the
# subcommand `state-diagram' and the pipeline of the diagrams call it: two
# copies of the generation are two diagrams that drift apart.
#
# The answers of the function are the answers of the wrapper: 3 when the
# tree has no kernel or the machine has no Emacs, 2 when the tree has no
# place for the diagram, and 1 when the generation itself failed.
generate_state_diagram() {
  if [ ! -f lib/yeah-state-diagram.el ]; then
    echo "scripts/dev state-diagram: the tree has no kernel (lib/yeah-state-diagram.el): the diagram of the state machine cannot be generated" >&2
    exit 3
  fi
  if [ ! -d site/diagrams ]; then
    echo "scripts/dev state-diagram: site/diagrams does not exist" >&2
    exit 2
  fi
  emacs_bin="$(find_emacs)" || {
    echo "scripts/dev state-diagram: emacs is not on PATH and EMACS is not set" >&2
    exit 3
  }
  # A stale .elc shadows a newer source (ELISP_BEST_PRACTICES §11.2), and
  # the diagram would be the diagram of yesterday.
  clean_bytecode
  out="site/diagrams/state-machine.puml"
  # The file is written next to its place and not in the temporary
  # directory of the machine: the move of it is then a rename, and a reader
  # of the diagram never sees a half-written file.
  tmp_puml="site/diagrams/.state-machine.$$"
  if ! : >"$tmp_puml"; then
    echo "scripts/dev state-diagram: cannot make a temporary file" >&2
    exit 3
  fi
  tmp_log="$tmp_puml.log"
  "$emacs_bin" -Q --batch -L lib -l yeah-state-diagram \
    --eval '(yeah-state-diagram-print)' >"$tmp_puml" 2>"$tmp_log"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "scripts/dev state-diagram: the generation of the diagram of the state machine failed" >&2
    cat "$tmp_log" >&2
    rm -f "$tmp_puml" "$tmp_log"
    exit 1
  fi
  if [ ! -s "$tmp_puml" ]; then
    echo "scripts/dev state-diagram: the generation of the diagram of the state machine wrote nothing" >&2
    cat "$tmp_log" >&2
    rm -f "$tmp_puml" "$tmp_log"
    exit 1
  fi
  rm -f "$tmp_log"
  if ! mv "$tmp_puml" "$out"; then
    echo "scripts/dev state-diagram: cannot write $out" >&2
    rm -f "$tmp_puml"
    exit 1
  fi
  echo "state-diagram: wrote $out"
}

case "$cmd" in
  help|--help|-h)
    cat <<'EOF'
scripts/dev — Yeah development wrapper

Subcommands:
  smoke                 — print "yeah-dev ok" and exit 0
  byte-compile-all      — byte-compile lib/*.el (including lib/yeah.el), no warnings
  ert FILE...           — run ERT test files (tests/unit/*.el)
  check FILE...         — run the checks; every check has a limit of time
  bench [--run]         — validate the benchmark task set, or run the benchmark
  pixel                 — photograph the real interface and compare two pictures
  diagrams              — render every diagram of site/diagrams in both themes
  state-diagram         — write site/diagrams/state-machine.puml out of the code
  map                   — the standing specification: claims, states, uncovered
  run                   — execute the checks, bind the evidence, write the trail
  gate                  — the gate of the project (scripts/gate); the exit code is the verdict
  help                  — this text

Exit codes:
  0 — pass       (Green)
  1 — fail       (Red)
  2 — blocked    (input error)
  3 — unknown    (the method could not tell)

Environment:
  MATHC  — path to the math-coding binary (default: `mathc` on PATH)
  EMACS  — path to the Emacs binary (default: `emacs` on PATH)
  PLANTUML
         — path to the PlantUML binary (default: `plantuml` on PATH, then
           ~/.nix-profile/bin, then the store of nix).  PlantUML draws the
           diagrams of the site; it is the instrument of the author and not
           a part of the runtime.
  NIX_STORE_DIR
         — the store of nix where the tools are looked for last (default:
           /nix/store)
  YEAH_CHECK_TIMEOUT
         — the limit of one check, in seconds (default: 120).  A check that
           passed the limit is stopped, and the run answers with the third
           answer (3, unknown): nothing was refuted, the method could not
           tell.
  YEAH_GATE_TIMEOUT
         — the limit of one attempt of the run of the gate, in seconds
           (default: 1800).  A run that passed the limit is stopped, and
           the gate answers with the third answer (3, unknown).
  YEAH_GATE_ATTEMPTS
         — the number of attempts of the gate (default: 3).  A run that
           was killed is started again; a run that answered is not.
EOF
    ;;

  smoke)
    echo "yeah-dev ok ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
    exit 0
    ;;

  byte-compile-all)
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev byte-compile-all: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    if [ ! -d lib ]; then
      echo "scripts/dev byte-compile-all: lib/ does not exist" >&2
      exit 3
    fi
    out="$("$emacs_bin" -Q --batch -L lib -f batch-byte-compile lib/*.el 2>&1)"
    rc=$?
    clean_bytecode
    printf '%s\n' "$out"
    if [ $rc -ne 0 ]; then
      echo "scripts/dev byte-compile-all: the compilation failed" >&2
      exit 1
    fi
    if printf '%s\n' "$out" | grep -q "Warning:"; then
      echo "scripts/dev byte-compile-all: the compilation produced warnings" >&2
      exit 1
    fi
    ;;

  ert)
    if [ $# -lt 1 ]; then
      echo "scripts/dev ert: needs at least one test file" >&2
      exit 2
    fi
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev ert: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    clean_bytecode
    load_args=()
    for f in "$@"; do
      load_args+=(-l "$f")
    done
    "$emacs_bin" -Q --batch -L lib -L . "${load_args[@]}" -f ert-run-tests-batch-and-exit
    ;;

  check)
    if [ $# -lt 1 ]; then
      echo "scripts/dev check: needs at least one check file" >&2
      exit 2
    fi
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev check: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    timeout_bin="$(find_timeout)" || {
      echo "scripts/dev check: scripts/dev-timeout is missing" >&2
      exit 3
    }
    # A check that hangs must not eat the gate: the gate waits for the
    # check, and a check that never ends never lets the gate finish.
    # Every check runs under a limit, and a check that passed the limit
    # is stopped and reported with the third answer -- the method could
    # not tell.  It is not a refutation: nothing was refuted.
    limit="${YEAH_CHECK_TIMEOUT:-120}"
    case "$limit" in
      ''|*[!0-9]*)
        echo "scripts/dev check: YEAH_CHECK_TIMEOUT must be a whole number of seconds" >&2
        exit 2
        ;;
    esac
    clean_bytecode
    blocked=0
    failed=0
    unknown=0
    started="$(now_ms)"
    # Every check owns a life socket.  The servers that the check starts
    # watch that socket and end when the check ends -- even when the check
    # was killed and never got the chance to stop them.  A server left
    # behind by a finished check holds its socket and waits for a client
    # that never comes.
    life_dir="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/yeah}"
    if [ -z "$life_dir" ]; then
      life_dir="${TMPDIR:-/tmp}/yeah-$(id -u)"
    fi
    mkdir -p "$life_dir" 2>/dev/null && chmod 700 "$life_dir" 2>/dev/null
    n=0
    for f in "$@"; do
      before="$(now_ms)"
      n=$((n + 1))
      # A check does not change the machine of the person.  The rules of
      # the permissions live in the configuration of the user, so a check
      # that forgets to take its rules back writes them into the file of
      # the user -- and the next run of the check reads them and decides
      # by the state of the machine and not by the code.  Every check
      # gets a configuration of its own, empty, and it is taken away with
      # the check: the verdict of a check depends on the code alone.
      config_home="$(mktemp -d "${TMPDIR:-/tmp}/yeah-check-config-XXXXXX" 2>/dev/null || true)"
      if [ -z "$config_home" ] || [ ! -d "$config_home" ]; then
        echo "scripts/dev check: a configuration of its own could not be made for $f" >&2
        config_home=""
        rc=2
      else
        case "$f" in
          *.el)
            life_sock="$life_dir/yeah-life-check-$n-$$.sock"
            XDG_CONFIG_HOME="$config_home" YEAH_LIFE_SOCKET="$life_sock" \
              "$timeout_bin" "$limit" \
              "$emacs_bin" -Q --batch -L lib -L . \
              --eval "(progn (require 'yeah-life) (yeah-life-adopt-from-environment))" \
              -l "$f"
            rc=$?
            rm -f "$life_sock"
            ;;
          *.sh)
            XDG_CONFIG_HOME="$config_home" "$timeout_bin" "$limit" bash "$f"
            rc=$?
            ;;
          *)
            echo "scripts/dev check: unknown kind of check: $f" >&2
            exit 2
            ;;
        esac
      fi
      if [ -n "$config_home" ]; then
        rm -rf "$config_home"
      fi
      case "$rc" in
        0) ;;
        1) failed=1 ;;
        2) blocked=1 ;;
        3)
          unknown=1
          echo "scripts/dev check: the check passed the limit of ${limit}s and was stopped: $f" >&2
          ;;
        *) failed=1 ;;
      esac
      printf 'check: %6d ms  %s\n' "$(( $(now_ms) - before ))" "$f"
    done
    printf 'check: %6d ms  total for %s file(s)\n' "$(( $(now_ms) - started ))" "$#"
    # The order of the answers is the order of their strength: a blocked
    # run is not a run, a refutation is a statement, and "unknown" is the
    # absence of one.
    if [ "$blocked" -eq 1 ]; then
      exit 2
    fi
    if [ "$failed" -eq 1 ]; then
      exit 1
    fi
    if [ "$unknown" -eq 1 ]; then
      exit 3
    fi
    exit 0
    ;;

  bench)
    emacs_bin="$(find_emacs)" || {
      echo "scripts/dev bench: emacs is not on PATH and EMACS is not set" >&2
      exit 3
    }
    if [ ! -f bench/run-bench.el ]; then
      echo "scripts/dev bench: bench/run-bench.el does not exist" >&2
      exit 2
    fi
    mode="--self-check"
    for arg in "$@"; do
      case "$arg" in
        --run) mode="--run" ;;
        *)
          echo "scripts/dev bench: unknown option: $arg" >&2
          exit 2
          ;;
      esac
    done
    # The task checks call emacs themselves: EMACS tells them which one.
    # gptel is not part of this repository: YEAH_BENCH_GPTEL_PATH names the
    # directory it is installed in, so the Yeah harness can reach a provider.
    clean_bytecode
    gptel_args=()
    if [ -n "${YEAH_BENCH_GPTEL_PATH:-}" ]; then
      gptel_args=(-L "$YEAH_BENCH_GPTEL_PATH")
    fi
    EMACS="$emacs_bin" "$emacs_bin" -Q --batch "${gptel_args[@]}" -L lib -l bench/run-bench.el -- "$mode"
    exit $?
    ;;

  pixel)
    if [ ! -f tests/pixel/check-interface-is-seen.sh ]; then
      echo "scripts/dev pixel: tests/pixel/check-interface-is-seen.sh does not exist" >&2
      exit 2
    fi
    clean_bytecode
    bash tests/pixel/check-interface-is-seen.sh
    exit $?
    ;;

  diagrams)
    # The pipeline of the diagrams.  PlantUML is the instrument of the
    # author: the site publishes the pictures that are ready, and the site
    # itself has no build step.
    if [ $# -gt 0 ]; then
      echo "scripts/dev diagrams: takes no arguments" >&2
      exit 2
    fi
    if [ ! -d site/diagrams ]; then
      echo "scripts/dev diagrams: site/diagrams does not exist" >&2
      exit 2
    fi
    # The diagram of the state machine is written out of the code before
    # anything is drawn: the pictures of the site come from sources that the
    # code wrote, and a picture of a stale source is a stale picture.  A
    # generation that failed ends the pipeline with its own answer, and
    # nothing is drawn.
    generate_state_diagram
    plantuml_bin="$(find_plantuml)" || {
      echo "scripts/dev diagrams: plantuml is not on PATH, PLANTUML is not set, and it is not in the store of nix" >&2
      exit 3
    }
    out_dir="site/assets/diagrams"
    mkdir -p "$out_dir" || {
      echo "scripts/dev diagrams: cannot make $out_dir" >&2
      exit 3
    }
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/yeah-diagrams.XXXXXX")" || {
      echo "scripts/dev diagrams: cannot make a temporary directory" >&2
      exit 3
    }
    # The pictures are written in the temporary directory first and moved to
    # their place one by one: a render that fails leaves no half-written
    # picture behind.
    trap 'rm -rf "$tmp"' EXIT
    # Every diagram of the tree of the pictures is drawn, in every directory
    # of it: a picture in a subdirectory of `site/diagrams/' is a picture of
    # the site too, and the tree of the sources keeps its shape in the tree
    # of the pictures.  The skins of the themes are not pictures of the site,
    # and they are skipped wherever they stand.
    find site/diagrams -type f -name '*.puml' | LC_ALL=C sort >"$tmp/sources" || {
      echo "scripts/dev diagrams: cannot read the tree of the sources" >&2
      exit 2
    }
    diagrams=0
    pictures=0
    index=0
    while IFS= read -r src; do
      [ -f "$src" ] || continue
      name="$(basename "$src" .puml)"
      case "$name" in
        palette-*) continue ;;
      esac
      # The name of a picture in the tree of the pictures is the path of its
      # source without the root of the tree and without the extension: a
      # picture in a subdirectory keeps the subdirectory in front of it.
      stem="${src#site/diagrams/}"
      stem="${stem%.puml}"
      index=$((index + 1))
      if ! grep -q '^[[:space:]]*@startuml' "$src"; then
        echo "scripts/dev diagrams: $src has no @startuml line" >&2
        exit 2
      fi
      for theme in light dark; do
        palette="site/diagrams/palette-$theme.puml"
        if [ ! -f "$palette" ]; then
          echo "scripts/dev diagrams: $palette does not exist" >&2
          exit 2
        fi
        # The skin of a theme goes inside the diagram: a skinparam outside of
        # @startuml is an error of PlantUML.  The file that is rendered is
        # named after the source and the theme, and PlantUML writes the
        # picture after the name of that file.  The name of the file of the
        # wrapper is the path of the source with the slashes of it replaced
        # by dashes: two sources of the same name in two directories are two
        # files and not one.
        flat="$(printf '%s' "$stem" | tr '/' '-')"
        wrapper="$tmp/$flat-$theme.puml"
        sed "/^[[:space:]]*@startuml/r $palette" "$src" >"$wrapper"
        # Every source is drawn in a directory of its own: the pictures of two
        # sources do not lie on top of each other, and the search of the
        # picture of a diagram that names itself sees the pictures of that
        # source and of no other.
        out="$tmp/out/$index-$theme"
        mkdir -p "$out" || {
          echo "scripts/dev diagrams: cannot make $out" >&2
          exit 3
        }
        if ! "$plantuml_bin" -tsvg -o "$out" "$wrapper" >"$tmp/log" 2>&1; then
          echo "scripts/dev diagrams: plantuml failed on $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        picture="$out/$flat-$theme.svg"
        if [ ! -s "$picture" ]; then
          # A diagram that names itself (`@startuml name') makes PlantUML
          # write the picture under the name of the diagram and not under
          # the name of the file.  The picture that was written is the
          # picture of the theme, and it is given the name of the theme.
          written=()
          for candidate in "$out"/*.svg; do
            [ -f "$candidate" ] || continue
            written+=("$candidate")
          done
          if [ "${#written[@]}" -eq 1 ]; then
            picture="${written[0]}"
          fi
        fi
        if [ ! -s "$picture" ]; then
          echo "scripts/dev diagrams: plantuml wrote no picture for $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        if grep -q 'Syntax Error' "$picture"; then
          echo "scripts/dev diagrams: the picture of $name ($theme) is an error of PlantUML" >&2
          exit 1
        fi
        # The tree of the pictures keeps the shape of the tree of the sources.
        target="$out_dir"
        dir="${stem%/*}"
        if [ "$dir" != "$stem" ]; then
          target="$out_dir/$dir"
          mkdir -p "$target" || {
            echo "scripts/dev diagrams: cannot make $target" >&2
            exit 3
          }
        fi
        mv "$picture" "$target/$name-$theme.svg"
        pictures=$((pictures + 1))
      done
      diagrams=$((diagrams + 1))
    done <"$tmp/sources"
    # The pictures of the diagrams of D2.  The engine is the instrument of
    # the author, like PlantUML: the site publishes the pictures that are
    # ready, and the site itself has no build step.  The palette of a theme
    # goes before the picture, because D2 reads the variables and the styles
    # of the theme before the shapes of the picture.
    find site/diagrams -type f -name '*.d2' | LC_ALL=C sort >"$tmp/sources-d2" || {
      echo "scripts/dev diagrams: cannot read the tree of the sources of D2" >&2
      exit 2
    }
    while IFS= read -r src; do
      [ -f "$src" ] || continue
      name="$(basename "$src" .d2)"
      case "$name" in
        palette-*) continue ;;
      esac
      d2_bin="${d2_bin:-$(find_d2 || true)}"
      if [ -z "$d2_bin" ] || [ ! -x "$d2_bin" ]; then
        echo "scripts/dev diagrams: d2 is not on PATH, D2 is not set, and it is not in the store of nix" >&2
        exit 3
      fi
      stem="${src#site/diagrams/}"
      stem="${stem%.d2}"
      flat="$(printf '%s' "$stem" | tr '/' '-')"
      index=$((index + 1))
      for theme in light dark; do
        palette="site/diagrams/palette-$theme.d2"
        if [ ! -f "$palette" ]; then
          echo "scripts/dev diagrams: $palette does not exist" >&2
          exit 2
        fi
        wrapper="$tmp/$flat-$theme.d2"
        cat "$palette" "$src" >"$wrapper"
        out="$tmp/out/$index-$theme"
        mkdir -p "$out" || {
          echo "scripts/dev diagrams: cannot make $out" >&2
          exit 3
        }
        picture="$out/$flat-$theme.svg"
        if ! "$d2_bin" "$wrapper" "$picture" >"$tmp/log" 2>&1; then
          echo "scripts/dev diagrams: d2 failed on $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        if [ ! -s "$picture" ]; then
          echo "scripts/dev diagrams: d2 wrote no picture for $name ($theme)" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        # The picture of D2 is XML, and the engine of D2 0.7 writes a
        # malformed picture for a map written on one line.  The browser says
        # nothing about a broken picture, so the pipeline reads the picture
        # itself: Emacs is the reader of the tree here.
        emacs_bin="$(find_emacs)" || {
          echo "scripts/dev diagrams: emacs is not on PATH and EMACS is not set" >&2
          exit 3
        }
        if ! "$emacs_bin" -Q --batch --eval "(xml-parse-file \"$picture\")" >"$tmp/log" 2>&1; then
          echo "scripts/dev diagrams: the picture of $name ($theme) is not a well-formed XML" >&2
          cat "$tmp/log" >&2
          exit 1
        fi
        target="$out_dir"
        dir="${stem%/*}"
        if [ "$dir" != "$stem" ]; then
          target="$out_dir/$dir"
          mkdir -p "$target" || {
            echo "scripts/dev diagrams: cannot make $target" >&2
            exit 3
          }
        fi
        mv "$picture" "$target/$name-$theme.svg"
        pictures=$((pictures + 1))
      done
      diagrams=$((diagrams + 1))
    done <"$tmp/sources-d2"
    echo "diagrams: rendered $pictures picture(s) of $diagrams diagram(s) into $out_dir"
    ;;

  state-diagram)
    # The source of the diagram of the state machine, written out of the
    # code of the tree of the caller.  The file is written and not drawn:
    # the pictures of the site are the work of the pipeline of the
    # diagrams.
    if [ $# -gt 0 ]; then
      echo "scripts/dev state-diagram: takes no arguments" >&2
      exit 2
    fi
    generate_state_diagram
    exit 0
    ;;

  map)
    need_mathc
    "$mathc_bin" --root . map
    ;;

  run)
    need_mathc
    "$mathc_bin" --root . run
    rc=$?
    # The copies of the runs that are gone are removed after the run: a
    # run that was killed leaves its copy on disk, and the copy is about a
    # gigabyte of the machine that nobody asked to keep.  The copy of a run
    # that is alive is left alone.
    sweep_method_copies
    exit $rc
    ;;
  gate)
    # The gate of the project is one runner: scripts/gate.  This wrapper
    # does not keep a second copy of it.  Two copies of the gate are two
    # verdicts, and the copy that drifts is the one that runs the
    # project -- and the old copy was the one that waited for the run and
    # left it behind when the run was killed.
    if [ ! -x "$script_dir/gate" ]; then
      echo "scripts/dev gate: scripts/gate is missing" >&2
      exit 3
    fi
    exec "$script_dir/gate" "$@"
    ;;

  *)
    echo "scripts/dev: unknown subcommand: $cmd" >&2
    echo "Run \`scripts/dev help\` for the list of subcommands." >&2
    exit 2
    ;;
esac
