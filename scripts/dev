#!/usr/bin/env bash
# scripts/dev — Yeah v0.0.0-alpha development wrapper.
#
# This is the bootstrap CLI. Subcommands:
#   smoke                 — print "yeah-dev stub ok" and exit 0
#   validate              — run `lib/yeah-validate.el' over the current tree
#   byte-compile-all      — byte-compile lib/*.el
#
# Exit codes (per AGENTS.md):
#   0 — pass
#   1 — fail
#   2 — blocked
#   3 — infrastructure error
#
# Every subcommand prints what it did and either exits 0 or names
# the blocker.

set -eu

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|--help|-h)
    cat <<'EOF'
scripts/dev — Yeah v0.0.0-alpha development wrapper

Subcommands:
  smoke                 — print "yeah-dev stub ok" and exit 0
  validate              — run the Elisp validator over the current tree
  byte-compile-all      — byte-compile every file under lib/
  edit-loop-detect      — flag edit-loop pattern in recent commits
                          (not yet implemented)

Exit codes:
  0 — pass
  1 — fail
  2 — blocked
  3 — infrastructure error
EOF
    ;;

  smoke)
    echo "yeah-dev stub ok ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
    exit 0
    ;;

  validate)
    if ! command -v emacs >/dev/null 2>&1; then
      echo "scripts/dev validate: emacs is not on PATH" >&2
      exit 3
    fi
    emacs -Q --batch -L lib -l lib/yeah-validate.el \
          --eval "(yeah-validate)"
    ;;

  byte-compile-all)
    if ! command -v emacs >/dev/null 2>&1; then
      echo "scripts/dev byte-compile-all: emacs is not on PATH" >&2
      exit 3
    fi
    if [ ! -d lib ]; then
      echo "scripts/dev byte-compile-all: lib/ does not exist" >&2
      exit 3
    fi
    emacs -Q --batch -L lib -f batch-byte-compile lib/*.el
    ;;

  edit-loop-detect)
    echo "scripts/dev edit-loop-detect: not yet implemented (Tier 1 of ROADMAP.md)" >&2
    exit 1
    ;;

  *)
    echo "scripts/dev: unknown subcommand: $cmd" >&2
    echo "Run \`scripts/dev help\` for the list of subcommands." >&2
    exit 2
    ;;
esac
