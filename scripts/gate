#!/usr/bin/env bash
# scripts/gate — the gate of the project, in the foreground.
#
#   scripts/gate [--limit SECONDS] [--attempts N] [--changed]
#
# The gate is a run of the method and the map that follows it.  The old way
# around the death of a run was a watchdog: a detached process that read a
# log file every five seconds and started the run again when the log did
# not move.  The measurement of 2026-11-18: 147 commands `sleep' and forty-
# four minutes of waiting a day, and copies of the run left behind when the
# watchdog was stopped.
#
# This runner waits instead of watching.  The run of the method is started
# in the foreground, the gate waits for it, and a run that was killed is
# started again by the gate itself: the restart is not the work of a second
# process.  Nothing is polled here -- no log is read, and this script holds
# no command that sleeps.  The map is written when the run ends, so the map
# always says how far the run came.

# The changed gate is the gate of the development loop: it asks the method
# for the partial run (--changed) -- the claims whose binding still holds
# keep the observations they already have -- and it trades the patience of
# the full gate for an answer: one attempt, five minutes.  The full gate
# stays the default, because the release ritual is not partial.
#
# The tree of the run is owned by the runner of the pilot (scripts/live-
# pilot): the run of the method, its children and the group of the run are
# stopped together, and they are stopped when the run ends as well as when
# the gate is stopped.
#
# Exit codes (the scale of the method):
#   0 — pass  (the map is green)
#   1 — fail  (something was refuted)
#   2 — blocked (the input of the run was wrong)
#   3 — unknown (the method could not tell: the run was killed and the
#       attempts ran out, or the run passed the limit of its time, or the
#       map of the project could not be written)

set -u

usage() {
  echo "scripts/gate: usage: scripts/gate [--limit SECONDS] [--attempts N] [--changed]" >&2
  exit 2
}

dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$dir/.." && pwd)"

# The limit of one attempt, and the number of attempts.  A run that was
# killed is started again; a run that answered is not: an answer of the
# method is a statement, and a statement is not repeated.
limit="${YEAH_GATE_TIMEOUT:-1800}"
attempts="${YEAH_GATE_ATTEMPTS:-3}"
changed=0

# A caller that names its bounds keeps them, whatever the gate it runs:
# an explicit flag or an explicit environment variable wins over the
# defaults of the changed gate.
limit_given=0
attempts_given=0
[ -n "${YEAH_GATE_TIMEOUT:-}" ] && limit_given=1
[ -n "${YEAH_GATE_ATTEMPTS:-}" ] && attempts_given=1

while [ $# -gt 0 ]; do
  case "$1" in
    --limit)
      [ $# -ge 2 ] || usage
      limit="$2"
      limit_given=1
      shift 2
      ;;
    --limit=*)
      limit="${1#--limit=}"
      limit_given=1
      shift
      ;;
    --attempts)
      [ $# -ge 2 ] || usage
      attempts="$2"
      attempts_given=1
      shift 2
      ;;
    --attempts=*)
      attempts="${1#--attempts=}"
      attempts_given=1
      shift
      ;;
    --changed)
      changed=1
      shift
      ;;
    *)
      usage
      ;;
  esac
done

case "$limit" in
  ''|*[!0-9]*)
    echo "scripts/gate: the limit must be a whole number of seconds" >&2
    exit 2
    ;;
esac
case "$attempts" in
  ''|*[!0-9]*)
    echo "scripts/gate: the number of attempts must be a whole number" >&2
    exit 2
    ;;
esac
if [ "$limit" -lt 1 ]; then
  echo "scripts/gate: the limit must be at least one second" >&2
  exit 2
fi
if [ "$attempts" -lt 1 ]; then
  echo "scripts/gate: there must be at least one attempt" >&2
  exit 2
fi

# The changed gate answers instead of restarting: a partial run is the
# work of seconds, and a partial run that was killed says unknown.  The
# caller who wants the patience of the full gate names it.
if [ "$changed" = 1 ]; then
  if [ "$limit_given" = 0 ]; then
    limit=300
  fi
  if [ "$attempts_given" = 0 ]; then
    attempts=1
  fi
fi

# The knowledge of /proc lives in one place, and the place of the method
# lives in one place too.
# shellcheck source=scripts/lib/tree.sh
. "$dir/lib/tree.sh"
# shellcheck source=scripts/lib/method.sh
. "$dir/lib/method.sh"
# shellcheck source=scripts/lib/copies.sh
. "$dir/lib/copies.sh"

mathc_bin="$(find_mathc)" || {
  echo "scripts/gate: the method is not on PATH and MATHC is not set." >&2
  echo "  Get it from the math-coding repository: nix build  (it writes result/bin/mathc)." >&2
  exit 3
}

cd "$root"

pilot_pid=""

# Stop the run of the method and everything it started.  The stop is a
# signal to the tree of the run; the runner of the pilot stops it again
# from its side, and the gate waits for the runner to be gone.
stop_run() {
  if [ -n "$pilot_pid" ]; then
    stop_tree "$pilot_pid" TERM
    wait "$pilot_pid" 2>/dev/null || true
  fi
}

on_signal() {
  stop_run
  exit "$1"
}

trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'stop_run' EXIT

verdict=3
attempt=1
while :; do
  # The run is a child of the gate and the gate waits for it: the wait is
  # the whole of the watching.  The changed gate asks the method for the
  # partial run; the full gate asks for every claim.
  mathc_args=(--root . run)
  if [ "$changed" = 1 ]; then
    mathc_args+=(--changed)
  fi
  "$dir/live-pilot" --limit "$limit" -- "$mathc_bin" "${mathc_args[@]}" &
  pilot_pid=$!
  wait "$pilot_pid"
  rc=$?
  pilot_pid=""
  case "$rc" in
    0|1|2|3)
      # The method answered.  The answer is the verdict of the gate.
      verdict="$rc"
      break
      ;;
    *)
      # The run was killed by a signal.  The gate starts it again: the
      # restart is the work of the gate, and not the work of a watcher
      # that reads a log.
      if [ "$attempt" -ge "$attempts" ]; then
        echo "scripts/gate: the run was killed (code $rc) and the attempts ran out" >&2
        verdict=3
        break
      fi
      attempt=$((attempt + 1))
      echo "scripts/gate: the run was killed (code $rc); it is started again (attempt $attempt of $attempts)" >&2
      ;;
  esac
done

# The copies of the runs that are gone are removed before the map is
# written: the run that was killed left its copy on disk, and the copy is
# a gigabyte of the machine that nobody asked to keep.
sweep_method_copies

# The map is written when the run ends: the map is the state of the
# project, and it must say how far the run came -- even when the run was
# killed.
"$mathc_bin" --root . map
map_rc=$?
if [ "$map_rc" -ne 0 ]; then
  # The map is the state of the project.  A gate that answers 0 without a
  # green map answers about a state it does not know, so the answer of the
  # gate is the answer of the map: a map that says a claim is refuted is a
  # refusal (1), and a map that could not be written at all is unknown (3).
  # Unknown is never pass.
  echo "scripts/gate: the step map answered $map_rc: the map of the project is not green" >&2
  if [ "$verdict" -eq 0 ]; then
    case "$map_rc" in
      1|2) verdict="$map_rc" ;;
      *) verdict=3 ;;
    esac
  fi
fi
exit "$verdict"
