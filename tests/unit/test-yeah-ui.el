(require 'cl-lib)
(require 'ert)
(require 'yeah-ui)
(require 'yeah-ui-fixtures
         (expand-file-name "tests/support/yeah-ui-fixtures.el"))

(defun yeah-ui-test--blocks (view kind)
  "Return blocks of KIND from VIEW."
  (cl-remove-if-not (lambda (block) (eq kind (plist-get block :kind)))
                    (plist-get view :blocks)))

(defun yeah-ui-test--one-block (view kind)
  "Return the single block of KIND from VIEW."
  (let ((blocks (yeah-ui-test--blocks view kind)))
    (should (= 1 (length blocks)))
    (car blocks)))

(ert-deftest yeah-ui-view-correlates-parallel-same-name-tools-by-id ()
  (let* ((view (yeah-ui-view (yeah-ui-fixture-parallel)))
         (calls (plist-get view :calls))
         (first (nth 0 calls))
         (second (nth 1 calls))
         (activity (yeah-ui-test--one-block view :activity)))
    (should (= 2 (length calls)))
    (should (equal (mapcar (lambda (call) (plist-get call :id)) calls)
                   '("call-a" "call-b")))
    (should (equal (mapcar (lambda (call) (plist-get call :name)) calls)
                   '("probe" "probe")))
    (should (equal (plist-get first :args) '("/tmp/a")))
    (should (equal (plist-get second :args) '("/tmp/b")))
    (should (equal (plist-get first :result) "first result"))
    (should (equal (plist-get second :result) "second result"))
    (should (equal (mapcar (lambda (call) (plist-get call :request-id)) calls)
                   '(2 5)))
    (should (equal (mapcar (lambda (call) (plist-get call :event-id)) calls)
                   '(9 8)))
    (should (equal (mapcar (lambda (call) (plist-get call :state)) calls)
                   '(done done)))
    (should (plist-get first :ok))
    (should (equal (plist-get second :artifacts) '("/tmp/second.out")))
    (should (eq (plist-get second :truncated) t))
    (should (equal (plist-get second :metadata) '(:exit-status 0)))
    (should (equal (plist-get activity :children) calls))
    (should (eq (nth 0 (plist-get activity :children)) first))
    (should (eq (nth 1 (plist-get activity :children)) second))
    (should (equal (plist-get view :pending) (plist-get view :pending-approvals)))
    (should (eq (plist-get view :pending) (plist-get view :pending-approvals)))
    (should (= 0 (plist-get (plist-get view :status) :active-tool-count)))
    (should (eq 'completed (plist-get (plist-get view :status) :state)))
    (should (equal (plist-get view :capabilities) '(:ask :cancel)))))

(ert-deftest yeah-ui-view-preserves-session-metadata-and-compatibility-fields ()
  (let* ((view (yeah-ui-view (yeah-ui-fixture-parallel)))
         (session (plist-get view :session)))
    (should (equal session '(:id "fixture-session" :title "Parallel fixture"
                             :project "/tmp/project" :placement "service"
                             :profile "build" :model "fake-model")))
    (should (equal (mapcar (lambda (entry) (plist-get entry :role))
                           (plist-get view :transcript))
                   '("user" "assistant")))
    (should (equal (mapcar (lambda (entry) (plist-get entry :text))
                           (plist-get view :transcript))
                   '("run both" "both finished")))
    (dolist (entry (plist-get view :transcript))
      (should (memq (plist-get entry :kind) '(:user :assistant))))
    (let ((usage (plist-get view :usage)))
      (should (= 12 (plist-get usage :input)))
      (should (= 7 (plist-get usage :output)))
      (should (eq (plist-get usage :reported-p) t))
      (should (equal (cl-loop for (key _value) on usage by #'cddr collect key)
                     '(:input :output :reported-p :estimated))))
    (should (numberp (plist-get (plist-get view :usage) :estimated)))
    (should (> (plist-get (plist-get view :usage) :estimated) 0))))

(ert-deftest yeah-ui-view-legacy-unique-fallback-is-deterministic ()
  (let* ((records (yeah-ui-fixture-legacy))
         (view (yeah-ui-view records))
         (call (car (plist-get view :calls))))
    (should (= 1 (length (plist-get view :calls))))
    (should (equal (plist-get call :id) "legacy-tool:2"))
    (should (eq (plist-get call :correlation) 'legacy))
    (should (equal (plist-get call :args) '("/tmp/legacy")))
    (should (eq (plist-get call :state) 'done))
    (should (plist-get call :ok))
    (should (equal (plist-get call :result) "legacy result"))
    (should (= 2 (plist-get call :request-id)))
    (should (= 5 (plist-get call :event-id)))
    (should (equal (plist-get (plist-get view :session) :id) "legacy-session"))
    (should (equal (plist-get (plist-get view :session) :title)
                   "legacy question"))))

(ert-deftest yeah-ui-view-legacy-ambiguity-is-unknown-not-guessed ()
  (let* ((view (yeah-ui-view (yeah-ui-fixture-legacy-ambiguous)))
         (calls (plist-get view :calls))
         (fallbacks (cl-remove-if-not
                     (lambda (block)
                       (eq (plist-get block :fallback-reason)
                           'ambiguous-tool-correlation))
                     (plist-get view :blocks))))
    (should (= 2 (length calls)))
    (dolist (call calls)
      (should (eq (plist-get call :state) 'unknown))
      (should (eq (plist-get call :correlation) 'ambiguous))
      (should-not (plist-get call :result))
      (should-not (plist-get call :ok)))
    (should (= 1 (length fallbacks)))
    (should (equal (plist-get (car fallbacks) :event-type) "tool-end"))
    (should (equal (plist-get (plist-get (car fallbacks) :record) :payload)
                   "unassignable result"))
    (should (= 0 (plist-get (plist-get view :status) :active-tool-count)))))

(ert-deftest yeah-ui-view-legacy-permission-ambiguity-is-unknown ()
  (let* ((records
          (list
           (list :type "header" :id 0 :session_id "legacy-approvals")
           (list :type "user-message" :id 1 :payload "run both")
           (list :type "tool-request" :id 2 :tool "probe" :args "(\"target\")")
           (list :type "tool-request" :id 3 :tool "probe" :args "(\"target\")")
           (list :type "permission-request" :id 4
                 :action "probe" :resource "target")
           (list :type "permission-request" :id 5
                 :action "probe" :resource "target")
           (list :type "permission-decision" :id 6
                 :action "probe" :resource "target" :effect "allow")))
         (view (yeah-ui-view records)))
    (dolist (call (plist-get view :calls))
      (should (eq (plist-get call :state) 'unknown))
      (should (eq (plist-get call :correlation) 'ambiguous)))
    (dolist (approval (yeah-ui-test--blocks view :approval))
      (should (eq (plist-get approval :state) 'unknown))
      (should (eq (plist-get approval :correlation) 'ambiguous)))
    (should-not (plist-get view :pending-approvals))
    (should (eq (plist-get (plist-get view :status) :state) 'unknown))
    (let ((fallback (yeah-ui-test--one-block view :event)))
      (should (eq (plist-get fallback :fallback-reason)
                  'ambiguous-permission-correlation)))))

(ert-deftest yeah-ui-view-links-child-lineage-and-finish ()
  (let* ((view (yeah-ui-view (yeah-ui-fixture-child)))
         (spawn (yeah-ui-test--one-block view :spawn))
         (end (yeah-ui-test--one-block view :child-end))
         (finish (yeah-ui-test--one-block view :finish)))
    (should (equal (plist-get spawn :lineage-id) "fixture-session.child"))
    (should (equal (plist-get end :lineage-id) "fixture-session.child"))
    (should (= 2 (plist-get spawn :spawn-id)))
    (should (= 2 (plist-get end :spawn-id)))
    (should (= 3 (plist-get spawn :child-end-id)))
    (should (= 2 (plist-get end :parent-event-id)))
    (should (eq (plist-get spawn :state) 'done))
    (should (eq (plist-get end :state) 'done))
    (should (plist-get end :ok))
    (should (equal (plist-get spawn :summary) "child summary"))
    (should (equal (plist-get finish :summary) "finished"))
    (should (eq (plist-get (plist-get view :status) :state) 'completed))))

(ert-deftest yeah-ui-view-deferred-permission-stays-pending-until-final-decision ()
  (let* ((records (yeah-ui-fixture-deferred))
         (deferred-view (yeah-ui-view records))
         (approval (yeah-ui-test--one-block deferred-view :approval))
         (call (car (plist-get deferred-view :calls))))
    (should (eq (plist-get approval :state) 'deferred))
    (should (equal (plist-get approval :effect) "defer"))
    (should (equal (plist-get approval :deferred-request-id) "permission-7"))
    (should (= 4 (plist-get approval :defer-event-id)))
    (should-not (plist-get approval :decision-id))
    (should (equal (plist-get deferred-view :pending-approvals) (list approval)))
    (should (eq (plist-get deferred-view :pending)
                (plist-get deferred-view :pending-approvals)))
    (should (eq (plist-get call :state) 'awaiting-approval))
    (should (= 0 (plist-get (plist-get deferred-view :status)
                            :active-tool-count)))
    (should (eq (plist-get (plist-get deferred-view :status) :state)
                'awaiting-approval))
    (let* ((final-records
            (append records
                    (list
                     (yeah-ui-fixture-event
                      5 "permission-decision"
                      :tool_call_id "call-deferred" :parent_event_id 4
                      :action "probe" :resource "target" :effect "allow")
                     (yeah-ui-fixture-event
                      6 "tool-end"
                      :tool_call_id "call-deferred" :parent_event_id 2
                      :tool "probe" :ok t :payload "approved result")
                     (yeah-ui-fixture-event 7 "finish" :summary "done"))))
           (final-view (yeah-ui-view final-records))
           (final-approval (yeah-ui-test--one-block final-view :approval))
           (final-call (car (plist-get final-view :calls))))
      (should (eq (plist-get final-approval :state) 'approved))
      (should (= 5 (plist-get final-approval :decision-id)))
      (should (equal (plist-get final-approval :deferred-request-id)
                     "permission-7"))
      (should-not (plist-get final-view :pending-approvals))
      (should (eq (plist-get final-call :state) 'done))
      (should (equal (plist-get final-call :result) "approved result"))
      (should (= 6 (plist-get final-call :event-id)))
      (should (eq (plist-get (plist-get final-view :status) :state) 'completed)))))

(ert-deftest yeah-ui-view-tracks-pending-approvals-and-inputs-in-order ()
  (let* ((records (yeah-ui-fixture-pending))
         (queued-view (yeah-ui-view (cl-subseq records 0 4)))
         (view (yeah-ui-view records))
         (approval (yeah-ui-test--one-block view :approval))
         (call (car (plist-get view :calls))))
    (should (equal (mapcar (lambda (input) (plist-get input :id))
                           (plist-get queued-view :pending-inputs))
                   '("input-b" "input-a")))
    (should (equal (mapcar (lambda (input) (plist-get input :id))
                           (plist-get view :pending-inputs))
                   '("input-a")))
    (should (equal (plist-get (car (plist-get view :pending-inputs)) :kind)
                   "steering"))
    (should (eq (plist-get approval :state) 'pending))
    (should (eq (plist-get call :state) 'awaiting-approval))
    (should (equal (plist-get view :pending) (list approval)))
    (should (eq (plist-get view :pending) (plist-get view :pending-approvals)))
    (should (eq (plist-get (plist-get view :status) :state) 'awaiting-approval))
    (should (equal (plist-get view :capabilities)
                   '(:ask :steer :permissions :pending)))))

(ert-deftest yeah-ui-view-unknown-usage-is-not-zero ()
  (let ((usage (plist-get (yeah-ui-view (yeah-ui-fixture-without-usage)) :usage)))
    (should-not (plist-get usage :input))
    (should-not (plist-get usage :output))
    (should-not (plist-get usage :reported-p))
    (should (numberp (plist-get usage :estimated)))
    (should (> (plist-get usage :estimated) 0))))

(ert-deftest yeah-ui-view-distinguishes-reported-zero-from-missing-output ()
  (let* ((records (append (yeah-ui-fixture-without-usage)
                          (list (yeah-ui-fixture-event 3 "usage"
                                                       :input 0 :output nil))))
         (usage (plist-get (yeah-ui-view records) :usage)))
    (should (= 0 (plist-get usage :input)))
    (should-not (plist-get usage :output))
    (should (eq (plist-get usage :reported-p) t))))

(ert-deftest yeah-ui-view-covers-all-block-kinds-and-generic-fallback ()
  (let* ((view (yeah-ui-view (yeah-ui-fixture-block-kinds)))
         (activity (yeah-ui-test--one-block view :activity))
         (kinds (append (mapcar (lambda (block) (plist-get block :kind))
                                (plist-get view :blocks))
                        (mapcar (lambda (call) (plist-get call :kind))
                                (plist-get activity :children)))))
    (dolist (kind '(:user :assistant :reasoning :activity :tool :approval
                    :compaction :pruning :steering :nudge :cancel :finish :error
                    :spawn :child-end :input-withdrawn :event))
      (should (memq kind kinds)))
    (let ((fallback (yeah-ui-test--one-block view :event)))
      (should (equal (plist-get fallback :event-type) "future-event"))
      (should (equal (plist-get (plist-get fallback :record) :payload)
                     "preserve me")))
    (should (eq (plist-get (yeah-ui-test--one-block view :spawn) :state) 'failed))
    (should (eq (plist-get (plist-get view :status) :state) 'failed))
    (should (equal (plist-get (plist-get view :status) :error) "broken"))))

(ert-deftest yeah-ui-view-is-repeatable-and-does-not-mutate-records ()
  (let* ((records (yeah-ui-fixture-parallel))
         (before (copy-tree records))
         (expected (yeah-ui-view records)))
    (should (equal records before))
    (dotimes (_ 20)
      (should (equal (yeah-ui-view records) expected)))
    (should (equal (mapcar (lambda (call) (plist-get call :id))
                           (plist-get expected :calls))
                   '("call-a" "call-b")))))

