# The Emacs layer of Yeah: the person, the editor's Emacs, the agent's Emacs
# and the bridge between them.
#
# The editor's Emacs is the environment of the person: their packages, their
# configuration, their buffers.  The agent's Emacs is the harness: the kernel
# of the agent runs there.  The bridge is the only path from the harness to
# the live state of the editor's Emacs, and it is a capability the person
# approves on purpose -- not a scraping of files and process output.
#
# The wire of the placement carries the prompt and the answer of the person;
# the bridge carries the other way, from the harness to the live state.
#
# The six capabilities of the layer are the six points of the section of the
# site that this picture belongs to: BUFFERS, INTROSPECT, EDIT, DIAGNOSE,
# COMPOSE and RECOVER.  DIAGNOSE has two halves: the doctor the person runs
# in the editor and the diagnostics the agent calls in the harness.
#
# Every block names the file that implements it, as `file:line'.

direction: down

# The engine of this one picture is elk: its layout stacks the editor's
# leaves and the harness's leaves into columns that fit the column of the
# page, and dagre spreads them into rows that the page would scale down
# until the words of the picture are smaller than the words of the page.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

person: "the person\nM-x yeah\nlib/yeah.el:37"

editor: "the editor's Emacs -- the environment of the person" {
  buffers: "BUFFERS\nunsaved edits\nare context\nlib/yeah-bridge.el:210"
  compose: "COMPOSE\nyour tools remain\nyour tools\nlib/yeah-compose.el:83"
  diagnose: "DIAGNOSE\nno second\nbuild system\nlib/yeah-doctor-ui.el:148"
  approval: "The approval\nview\nlib/yeah-approval-ui.el:43"
}

harness: "the agent's Emacs -- the harness" {
  kernel: "The kernel\none turn of\nthe agent\nlib/yeah-turn.el:1471"
  introspect: "INTROSPECT\nthe runtime\nexplains itself\nlib/yeah-emacs.el:62"
  edit: "EDIT\nchanges respect\nthe buffer\nlib/yeah-diff.el:64"
  recover: "RECOVER\nhistory outlives\nthe interface\nlib/yeah-session.el:167"
}

bridge: "The bridge\nemacsclient\nlib/yeah-bridge.el:177" {
  class: subject
}

person -> editor.compose: {
  class: flow
  label: "writes the prompt"
}
editor.compose -> harness.kernel: {
  class: flow
  label: "the prompt"
}
person -> editor.approval: {
  class: flow
  label: "answers a request"
}
editor.approval -> harness.kernel: {
  class: flow
  label: "the answer decides\nwhat may run"
}
harness.kernel -> bridge: {
  class: flow
  label: "the only path\nto the live state"
}
bridge -> editor.buffers: {
  class: capability
  label: "a capability you\napprove on purpose"
}
harness.kernel -> harness.introspect: {
  class: flow
  label: "asks"
}
harness.kernel -> harness.edit: {
  class: flow
  label: "previews a change"
}
harness.kernel -> harness.recover: {
  class: flow
  label: "writes what happened"
}

note: "The human answers: :once, :session, :project, :global or :reject."

harness -> note: {
  class: hidden
}
