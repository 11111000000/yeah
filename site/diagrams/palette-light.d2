# Palette of the light theme — the faces of Emacs 30.2.
# The colours carry the site tokens of the theme.
#
# The palette is prepended to the source of the picture: the variables, the
# styles and the class of the connections live here, and the picture itself
# lives in its own file.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 30
  }
  canvas: "#FFFFFF"
  panel: "#F2F2F2"
  card: "#FFFFFF"
  line: "#999999"
  ink: "#000000"
  arrow: "#333333"
}

# The class of a connection: the arrow and its label carry the colour of the
# theme, not the colour of the engine.
classes: {
  hidden: {
    style: {
      stroke: ${canvas}
      font-color: ${canvas}
    }
  }
  flow: {
    style: {
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
  # The subject of the picture: the one block the picture is about.  Colour
  # never carries the meaning alone, so the subject is the border that is
  # heavier than the rest, and its name says what it is.
  subject: {
    style: {
      stroke-width: 3
    }
  }
  # A path the person approves on purpose: the bridge is a capability and
  # not a default, and a dashed line says so in every theme.
  capability: {
    style: {
      stroke-dash: 4
      stroke-width: 2
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
  # The kinds of an edge that crosses a boundary of responsibility.  The
  # label of the edge names the kind in words, and the style of the line
  # carries it again -- colour never carries the meaning alone.  The styles
  # are distinct on purpose, and the check
  # `check-the-edges-of-a-picture-carry-their-kind.el' holds them apart:
  # two kinds that share one style are one kind.
  request: {
    style: {
      stroke-dash: 0
      stroke-width: 3
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
  answer: {
    style: {
      stroke-dash: 2
      stroke-width: 2
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
  write: {
    style: {
      stroke-dash: 8
      stroke-width: 3
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
  project: {
    style: {
      stroke-dash: 6
      stroke-width: 2
      stroke: ${arrow}
      font-color: ${arrow}
    }
  }
}

# The canvas is the background of the picture, the panel is a band and a note,
# the card is a leaf.
style: {
  fill: ${canvas}
  stroke: ${line}
  stroke-width: 2
  font-color: ${ink}
  font-size: 19
  border-radius: 8
  shadow: false
}
*.style: {
  fill: ${panel}
  stroke: ${line}
  stroke-width: 2
  font-color: ${ink}
  font-size: 19
  border-radius: 8
  shadow: false
}
*.*.style: {
  fill: ${card}
  stroke: ${line}
  stroke-width: 2
  font-color: ${ink}
  font-size: 19
  border-radius: 8
  shadow: false
}
*.*.*.style: {
  fill: ${card}
  stroke: ${line}
  stroke-width: 2
  font-color: ${ink}
  font-size: 19
  border-radius: 8
  shadow: false
}
*.*.*.*.style: {
  fill: ${card}
  stroke: ${line}
  stroke-width: 2
  font-color: ${ink}
  font-size: 19
  border-radius: 8
  shadow: false
}
