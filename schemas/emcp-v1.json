{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "yeah/schemas/emcp-v1.json",
  "title": "emcp tool surface (v1)",
  "description": "The first-wave MCP tool surface of Yeah under the `emacs__*` namespace. Tool ids are stable; renaming any entry is a protected-policy transition. `tools` is the whole registry in lib/yeah-emcp.el. `published` is the subset the MCP server offers by default: the read-only tools. An operator may widen the published set with `yeah-emcp-publish-extra-tools`, and the registry remains the source of truth in every case.",
  "type": "object",
  "required": ["tools", "published"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/definitions/tool" }
    },
    "published": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string", "pattern": "^emacs__[a-z_]+$" }
    }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["id", "description", "input", "output"],
      "properties": {
        "id":          { "type": "string", "pattern": "^emacs__[a-z_]+$" },
        "description": { "type": "string", "minLength": 1 },
        "input":  { "type": "array", "items": { "type": "string" }, "minItems": 0 },
        "output": { "type": "string", "enum": ["string", "json-string", "buffer-string"] }
      }
    }
  },
  "examples": {
    "tools": [
      { "id": "emacs__buffer_list",      "description": "List live buffers, optionally filtered by a name prefix.",          "input": ["prefix"],                       "output": "string" },
      { "id": "emacs__buffer_read",      "description": "Return the contents of a buffer, optionally restricted to a range.", "input": ["name", "start", "end"],         "output": "buffer-string" },
      { "id": "emacs__buffer_write",     "description": "Replace or insert text in a buffer at a given position.",            "input": ["name", "start", "end", "text"], "output": "string" },
      { "id": "emacs__magit_status",     "description": "Return the current Magit status buffer as a string.",                "input": [],                               "output": "buffer-string" },
      { "id": "emacs__describe_function","description": "Return the help string of a function symbol.",                        "input": ["symbol"],                       "output": "string" },
      { "id": "emacs__describe_variable","description": "Return the help string of a variable symbol.",                        "input": ["symbol"],                       "output": "string" },
      { "id": "emacs__dired_list",       "description": "List files in a directory (default: project root).",                  "input": ["directory"],                    "output": "string" },
      { "id": "emacs__project_find_file","description": "Find a file by name within the current project.",                    "input": ["name"],                         "output": "string" },
      { "id": "emacs__eval",             "description": "Evaluate an Emacs Lisp expression and return its value as a string.", "input": ["expr"],                         "output": "string" }
    ],
    "published": [
      "emacs__buffer_list",
      "emacs__buffer_read",
      "emacs__magit_status",
      "emacs__describe_function",
      "emacs__describe_variable",
      "emacs__dired_list",
      "emacs__project_find_file"
    ]
  }
}
