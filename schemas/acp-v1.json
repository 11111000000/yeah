{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeah/acp-v1.json",
  "title": "ACP v1 — Yeah subset",
  "description": "The subset of the Agent Client Protocol v1 that Yeah speaks on the agent side over newline-delimited JSON-RPC 2.0. Method names and field names follow the protocol; the transport is stdio.",
  "definitions": {
    "RequestId": {
      "type": ["integer", "string"]
    },
    "InitializeRequest": {
      "type": "object",
      "required": ["protocolVersion"],
      "properties": {
        "protocolVersion": { "type": "integer", "description": "ACP wire version the client speaks." },
        "clientInfo": { "type": "object", "additionalProperties": true },
        "clientCapabilities": { "type": "object", "additionalProperties": true }
      }
    },
    "InitializeResponse": {
      "type": "object",
      "required": ["protocolVersion", "agentInfo"],
      "properties": {
        "protocolVersion": { "type": "integer" },
        "agentInfo": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "agentCapabilities": { "type": "object", "additionalProperties": true }
      }
    },
    "NewSessionRequest": {
      "type": "object",
      "required": ["cwd", "mcpServers"],
      "properties": {
        "cwd": { "type": "string", "description": "Absolute working directory of the session." },
        "mcpServers": { "type": ["array", "null"] },
        "additionalDirectories": { "type": ["array", "null"] }
      }
    },
    "NewSessionResponse": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "type": "string" }
      }
    },
    "PromptRequest": {
      "type": "object",
      "required": ["sessionId", "prompt"],
      "properties": {
        "sessionId": { "type": "string" },
        "prompt": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContentBlock" }
        }
      }
    },
    "PromptResponse": {
      "type": "object",
      "required": ["stopReason"],
      "properties": {
        "stopReason": {
          "type": "string",
          "enum": ["end_turn", "max_tokens", "max_turn_requests", "refusal", "cancelled"]
        }
      }
    },
    "CancelNotification": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "type": "string" }
      }
    },
    "ContentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["text", "resource_link"] },
        "text": { "type": "string" },
        "name": { "type": "string" },
        "uri": { "type": "string" }
      }
    },
    "SessionUpdateNotification": {
      "type": "object",
      "required": ["sessionId", "update"],
      "properties": {
        "sessionId": { "type": "string" },
        "update": {
          "type": "object",
          "required": ["sessionUpdate"],
          "properties": {
            "sessionUpdate": {
              "type": "string",
              "enum": ["user_message_chunk", "agent_message_chunk", "tool_call", "tool_call_update"]
            },
            "content": { "type": "array" },
            "toolCallId": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "string" }
          }
        }
      }
    }
  }
}
